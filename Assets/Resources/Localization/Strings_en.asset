  m_EditorClassIdentifier: Game.Runtime::Game.Core.Localization.StringTable
  languageCode: en
  languageName: English
  entries:
  - Key: hud.health
    Value: Health  {0}/{1}
    Note: HUD bar. {0} current, {1} maximum.
  - Key: hud.stamina
    Value: Stamina  {0}/{1}
    Note: HUD bar.
  - Key: hud.divine
    Value: Divine  {0}/{1}
    Note: HUD bar. Divine energy.
  - Key: hud.locked_on
    Value: 'Locked: {0}'
    Note: '{0} is the enemy''s name.'
  - Key: hud.combo
    Value: '{0}  x{1}'
    Note: '{0} combo name, {1} damage multiplier.'
  - Key: hud.parry
    Value: Parry
    Note: Flashed on a successful parry.
  - Key: hud.perfect_parry
    Value: Perfect parry
    Note: Flashed on a perfectly timed parry.
  - Key: hud.guard_broken
    Value: Guard broken
    Note: Flashed when the player's guard breaks.
  - Key: journal.quest_row
    Value: '{0}  [{1}]'
    Note: '{0} quest title, {1} status word.'
  - Key: journal.objective_count
    Value: '  ({0}/{1})'
    Note: Appended to an objective. {0} done, {1} needed.
  - Key: journal.memory_integrity
    Value: 'Memory Integrity: {0}%'
    Note: '{0} is a whole number 0-100.'
  - Key: journal.memory_row
    Value: '{0}  -  {1}, {2}'
    Note: '{0} title, {1} category, {2} state.'
  - Key: journal.corrupt
    Value: Corrupt
    Note: Shown against a corrupted memory.
  - Key: progression.skill_points
    Value: 'Skill Points: {0}'
    Note: 
  - Key: progression.item_count
    Value: '  x{0}'
    Note: Appended to a stackable item's name.
  - Key: progression.skill_row
    Value: '    {0}  {1}'
    Note: '{0} skill name, {1} its unlocked/cost marker.'
  - Key: progression.unlocked
    Value: '[unlocked]'
    Note: Marker beside an owned skill.
  - Key: progression.cost
    Value: '[{0} pt]'
    Note: '{0} is the skill point cost.'
  - Key: progression.unlock_button
    Value: Unlock
    Note: Button label.
  - Key: quest.objective_complete
    Value: Complete
    Note: Objective state in the tracker.
  - Key: quest.objective_failed
    Value: Failed
    Note: Objective state in the tracker.
  - Key: quest.objective_count
    Value: '{0}  ({1}/{2})'
    Note: '{0} description, {1} done, {2} needed.'
  - Key: menu.save_row
    Value: '{0}

      {1}  -  {2}'
    Note: '{0} slot name, {1} scene, {2} date and time.'
  - Key: menu.save_row_empty
    Value: '{0}

      (empty)'
    Note: '{0} is the slot name.'
  - Key: menu.difficulty
    Value: 'Difficulty: {0}'
    Note: '{0} is the difficulty name.'
  - Key: menu.resolution
    Value: '{0} x {1}'
    Note: '{0} width, {1} height, in pixels.'
  - Key: remap.listening
    Value: Press any key or button...
    Note: Shown while waiting for a rebind.
  - Key: remap.button
    Value: Rebind
    Note: Button label.
  - Key: map.checkpoint_reached
    Value: '{0} (reached)'
    Note: '{0} is the checkpoint''s name.'
  - Key: map.boss_defeated
    Value: '{0} (defeated)'
    Note: '{0} is the boss''s name.'
  - Key: memory.recovered
    Value: Memory recovered - {0}
    Note: '{0} is the memory''s title.'
  - Key: interaction.prompt
    Value: '{0} {1}'
    Note: '{0} a verb such as Speak to, {1} the thing''s name.'
  - Key: interaction.prompt_with_key
    Value: '[{0}]  {1}'
    Note: '{0} the key to press, {1} the prompt.'
  - Key: interaction.take_item
    Value: Take {0}
    Note: '{0} is the item''s name.'
  - Key: interaction.take_item_generic
    Value: Take item
    Note: Used when the item has no name yet.
  - Key: interaction.toll_pay
    Value: Offer a memory to pass ({0} integrity)
    Note: '{0} is a percentage such as 15%.'
  - Key: interaction.toll_paid
    Value: The way is open
    Note: Shown once a memory toll is paid.
  - Key: save.backup_restored
    Value: Your previous save could not be loaded. A safe backup has been restored.
    Note: SPEC.md section 32 requires this wording. Translate the meaning exactly.
  - Key: save.refused
    Value: The game cannot be saved right now.
    Note: Shown when saving is blocked.
  - Key: save.failed
    Value: The game could not be saved.
    Note: Shown when writing the file failed.
  - Key: save.load_failed
    Value: That save could not be loaded.
    Note: 
  - Key: world.fell_out_of_world
    Value: You fell out of the world. Returned to the last checkpoint.
    Note: 
  - Key: device.controller_lost
    Value: Controller disconnected. The game is paused.
    Note: 
  - Key: device.controller_found
    Value: Controller reconnected.
    Note: 
  - Key: dialogue.unavailable
    Value: '[Dialogue unavailable]'
    Note: Shown when a conversation has no available line.
  - Key: item.astra_blade.name
    Value: 'Astra Blade'
    Note: 'Item display name (ASTRA_BLADE).'
  - Key: item.divine_mark.name
    Value: 'Divine Mark'
    Note: 'Item display name (DIVINE_MARK).'
  - Key: item.ember_draught.name
    Value: 'Ember Draught'
    Note: 'Item display name (EMBER_DRAUGHT).'
  - Key: memory.mem_001.description
    Value: 'The ruin stone carries eight seats, not seven. Someone has ground the eighth name away, patiently, with a blade - not to deface it, but to finish it. Underneath the damage the carving is still legible in the way a scar is legible. You do not know the name. You are certain you have said it before.'
    Note: 'Memory description (MEM_001).'
  - Key: memory.mem_001.title
    Value: 'The Name Beneath the Stone'
    Note: 'Memory display name (MEM_001).'
  - Key: memory.mem_002.description
    Value: 'The stone that carried it is broken open now, and what was sealed inside is a memory that is not quite yours and not quite anyone''s - a vow spoken by something built to keep one thing safe for longer than the word "forever" was supposed to mean. It does not know its vow is finished. It only knows it is not moving anymore.'
    Note: 'Memory description (MEM_002).'
  - Key: memory.mem_002.title
    Value: 'The Guardian''s Vow'
    Note: 'Memory display name (MEM_002).'
  - Key: memory.mem_003.description
    Value: 'The flame does not go out when the god falls. It just stops pretending to be a god and remembers being fire - patient, indifferent, older than the seven, older than the day they chose to be seven. Somewhere in the heat you were sure you heard it say your true name before it forgot how.'
    Note: 'Memory description (MEM_003).'
  - Key: memory.mem_003.title
    Value: 'Agniya''s Ember'
    Note: 'Memory display name (MEM_003).'
  - Key: quest.q001.description
    Value: 'Queen Amara has asked you to walk out to the old ruins past the temple district and bring back whatever is carved there.'
    Note: 'Quest description (Q001).'
  - Key: quest.q001.objective.find_memory
    Value: 'Recover what the ruins remember'
    Note: 'Quest objective (Q001/FIND_MEMORY).'
  - Key: quest.q001.objective.reach_ruins
    Value: 'Search the ruins beyond the temple district'
    Note: 'Quest objective (Q001/REACH_RUINS).'
  - Key: quest.q001.objective.return_amara
    Value: 'Return to Queen Amara'
    Note: 'Quest objective (Q001/RETURN_AMARA).'
  - Key: quest.q001.rewards
    Value: 'Queen Amara''s mark of trust, and the clarity that comes of recovering something true.'
    Note: 'Quest reward summary (Q001).'
  - Key: quest.q001.title
    Value: 'The Queen''s Charge'
    Note: 'Quest display name (Q001).'
  - Key: quest.q002.description
    Value: 'Something crawled out of the ruins behind you. Put it down.'
    Note: 'Quest description (Q002).'
  - Key: quest.q002.objective.defeat_ruin_guards
    Value: 'Defeat what guards the ruins'
    Note: 'Quest objective (Q002/DEFEAT_RUIN_GUARDS).'
  - Key: quest.q002.rewards
    Value: 'Two ember draughts from the guards you put down, and what the fight taught you.'
    Note: 'Quest reward summary (Q002).'
  - Key: quest.q002.title
    Value: 'The Ash at the Gate'
    Note: 'Quest display name (Q002).'
  - Key: quest.q003.description
    Value: 'A temple stands where the city stops pretending to be a city. Something inside it is still burning, and still calling itself a god.'
    Note: 'Quest description (Q003).'
  - Key: quest.q003.objective.defeat_flame_sovereign
    Value: 'Put down what the fire is pretending to be'
    Note: 'Quest objective (Q003/DEFEAT_FLAME_SOVEREIGN).'
  - Key: quest.q003.objective.light_the_braziers
    Value: 'Wake the fire the temple was built around'
    Note: 'Quest objective (Q003/LIGHT_THE_BRAZIERS).'
  - Key: quest.q003.objective.reach_agniya_temple
    Value: 'Go to the temple beyond the district'
    Note: 'Quest objective (Q003/REACH_AGNIYA_TEMPLE).'
  - Key: quest.q003.objective.take_agniyas_ember
    Value: 'Take what is left when the god stops'
    Note: 'Quest objective (Q003/TAKE_AGNIYAS_EMBER).'
  - Key: quest.q003.rewards
    Value: 'Ember Step, and one more thing you are certain you used to know.'
    Note: 'Quest reward summary (Q003).'
  - Key: quest.q003.title
    Value: 'The Ember and the Sovereign'
    Note: 'Quest display name (Q003).'
  - Key: skill.divine_cooldown.name
    Value: 'Swift Renewal'
    Note: 'Skill display name (DIVINE_COOLDOWN).'
  - Key: skill.divine_energy.name
    Value: 'Deep Well'
    Note: 'Skill display name (DIVINE_ENERGY).'
  - Key: skill.divine_power.name
    Value: 'Ember Reach'
    Note: 'Skill display name (DIVINE_POWER).'
  - Key: skill.guardian_block.name
    Value: 'Steady Guard'
    Note: 'Skill display name (GUARDIAN_BLOCK).'
  - Key: skill.guardian_health.name
    Value: 'Vitality'
    Note: 'Skill display name (GUARDIAN_HEALTH).'
  - Key: skill.guardian_reduction.name
    Value: 'Thick Skin'
    Note: 'Skill display name (GUARDIAN_REDUCTION).'
  - Key: skill.memory_detection.name
    Value: 'Keen Eye'
    Note: 'Skill display name (MEMORY_DETECTION).'
  - Key: skill.memory_manipulation.name
    Value: 'Careful Hand'
    Note: 'Skill display name (MEMORY_MANIPULATION).'
  - Key: skill.memory_restoration.name
    Value: 'Steady Mind'
    Note: 'Skill display name (MEMORY_RESTORATION).'
  - Key: skill.warrior_combo.name
    Value: 'Extended Combos'
    Note: 'Skill display name (WARRIOR_COMBO).'
  - Key: skill.warrior_damage.name
    Value: 'Heavier Strikes'
    Note: 'Skill display name (WARRIOR_DAMAGE).'
  - Key: skill.warrior_parry.name
    Value: 'Parry Timing'
    Note: 'Skill display name (WARRIOR_PARRY).'
  - Key: item.astra_blade.description
    Value: 'The blade carried from the start of the journey.'
    Note: 'Item description (ASTRA_BLADE).'
  - Key: item.divine_mark.description
    Value: 'Queen Amara''s mark of trust.'
    Note: 'Item description (DIVINE_MARK).'
  - Key: item.ember_draught.description
    Value: 'Restores 30 health when used.'
    Note: 'Item description (EMBER_DRAUGHT).'
  - Key: skill.divine_cooldown.description
    Value: 'Ember Step''s cooldown is 20% shorter.'
    Note: 'Skill description (DIVINE_COOLDOWN).'
  - Key: skill.divine_energy.description
    Value: 'Gain 20 maximum Divine Energy.'
    Note: 'Skill description (DIVINE_ENERGY).'
  - Key: skill.divine_power.description
    Value: 'Ember Step travels 20% faster.'
    Note: 'Skill description (DIVINE_POWER).'
  - Key: skill.guardian_block.description
    Value: 'Blocking costs 10% less stamina.'
    Note: 'Skill description (GUARDIAN_BLOCK).'
  - Key: skill.guardian_health.description
    Value: 'Gain 20 maximum health.'
    Note: 'Skill description (GUARDIAN_HEALTH).'
  - Key: skill.guardian_reduction.description
    Value: 'Take 10% less damage.'
    Note: 'Skill description (GUARDIAN_REDUCTION).'
  - Key: skill.memory_detection.description
    Value: 'Reach memory fragments from 50% farther away.'
    Note: 'Skill description (MEMORY_DETECTION).'
  - Key: skill.memory_manipulation.description
    Value: 'Corrupting a memory costs 25% less integrity.'
    Note: 'Skill description (MEMORY_MANIPULATION).'
  - Key: skill.memory_restoration.description
    Value: 'Temporarily forgotten memories return 30% sooner.'
    Note: 'Skill description (MEMORY_RESTORATION).'
  - Key: skill.warrior_combo.description
    Value: 'The combo input window is 0.3 seconds longer.'
    Note: 'Skill description (WARRIOR_COMBO).'
  - Key: skill.warrior_damage.description
    Value: 'Weapon attacks deal 15% more damage.'
    Note: 'Skill description (WARRIOR_DAMAGE).'
  - Key: skill.warrior_parry.description
    Value: 'The parry timing window is 20% longer.'
    Note: 'Skill description (WARRIOR_PARRY).'
  - Key: dialogue.dlg_amara.node.amara_accept.speaker
    Value: 'Queen Amara'
    Note: 'Dialogue DLG_AMARA/AMARA_ACCEPT speaker.'
  - Key: dialogue.dlg_amara.node.amara_accept.text
    Value: 'Go quietly. Take nothing from the stone but what it says. And Ishan - if you find you already know what is written there, come back faster.'
    Note: 'Dialogue DLG_AMARA/AMARA_ACCEPT text.'
  - Key: dialogue.dlg_amara.node.amara_after.speaker
    Value: 'Queen Amara'
    Note: 'Dialogue DLG_AMARA/AMARA_AFTER speaker.'
  - Key: dialogue.dlg_amara.node.amara_after.text
    Value: 'I lost the end of that sentence. Beyond the district, the road from the stone reaches a temple. Its fire may remember what I cannot. Follow that road until it gives up its secret.'
    Note: 'Dialogue DLG_AMARA/AMARA_AFTER text.'
  - Key: dialogue.dlg_amara.node.amara_doubt.speaker
    Value: 'Queen Amara'
    Note: 'Dialogue DLG_AMARA/AMARA_DOUBT speaker.'
  - Key: dialogue.dlg_amara.node.amara_doubt.text
    Value: 'No. They are not wrong. That is exactly what troubles me. A wrong history can be corrected. A history that is complete and still short one seat is something else.'
    Note: 'Dialogue DLG_AMARA/AMARA_DOUBT text.'
  - Key: dialogue.dlg_amara.node.amara_intro.speaker
    Value: 'Queen Amara'
    Note: 'Dialogue DLG_AMARA/AMARA_INTRO speaker.'
  - Key: dialogue.dlg_amara.node.amara_intro.text
    Value: 'Ishan. Good. I have had the same dream four nights running, and I am told that is not a thing queens are permitted to mention aloud.'
    Note: 'Dialogue DLG_AMARA/AMARA_INTRO text.'
  - Key: dialogue.dlg_amara.node.amara_intro_2.choice.0
    Value: 'I''ll go now.'
    Note: 'Dialogue choice DLG_AMARA/AMARA_INTRO_2 #1.'
  - Key: dialogue.dlg_amara.node.amara_intro_2.choice.1
    Value: 'Eight? The histories are not wrong about the gods.'
    Note: 'Dialogue choice DLG_AMARA/AMARA_INTRO_2 #2.'
  - Key: dialogue.dlg_amara.node.amara_intro_2.speaker
    Value: 'Queen Amara'
    Note: 'Dialogue DLG_AMARA/AMARA_INTRO_2 speaker.'
  - Key: dialogue.dlg_amara.node.amara_intro_2.text
    Value: 'In it, there are eight thrones on the ruin stone past the temple district. Our histories record seven gods. I would like you to go and count them for me.'
    Note: 'Dialogue DLG_AMARA/AMARA_INTRO_2 text.'
  - Key: dialogue.dlg_amara.node.amara_return.choice.0
    Value: 'Eight. The last one was scraped out.'
    Note: 'Dialogue choice DLG_AMARA/AMARA_RETURN #1.'
  - Key: dialogue.dlg_amara.node.amara_return.choice.1
    Value: 'Eight. And I think I knew the name.'
    Note: 'Dialogue choice DLG_AMARA/AMARA_RETURN #2.'
  - Key: dialogue.dlg_amara.node.amara_return.speaker
    Value: 'Queen Amara'
    Note: 'Dialogue DLG_AMARA/AMARA_RETURN speaker.'
  - Key: dialogue.dlg_amara.node.amara_return.text
    Value: 'You counted them. I can see it on you. How many?'
    Note: 'Dialogue DLG_AMARA/AMARA_RETURN text.'
  - Key: dialogue.dlg_amara.node.amara_return_2.speaker
    Value: 'Queen Amara'
    Note: 'Dialogue DLG_AMARA/AMARA_RETURN_2 speaker.'
  - Key: dialogue.dlg_amara.node.amara_return_2.text
    Value: 'Then we have both dreamed it. Ishan, I want you to listen carefully, because I am about to say something I will not be able to repeat, and I do not know why I am so certain of that -'
    Note: 'Dialogue DLG_AMARA/AMARA_RETURN_2 text.'
  - Key: dialogue.dlg_amara.node.amara_temple_complete.speaker
    Value: 'Queen Amara'
    Note: 'Dialogue DLG_AMARA/AMARA_TEMPLE_COMPLETE speaker.'
  - Key: dialogue.dlg_amara.node.amara_temple_complete.text
    Value: 'The ash on you is from that temple. I remember sending you to the stone, but not the words I meant to say after. Tell me what survived the fire when you can.'
    Note: 'Dialogue DLG_AMARA/AMARA_TEMPLE_COMPLETE text.'
  - Key: dialogue.dlg_amara.node.amara_waiting.speaker
    Value: 'Queen Amara'
    Note: 'Dialogue DLG_AMARA/AMARA_WAITING speaker.'
  - Key: dialogue.dlg_amara.node.amara_waiting.text
    Value: 'The ruins are past the temple district, where the ground stops being ours. Mira can tell you what the older carvings mean, if you can get her to stop at one sentence.'
    Note: 'Dialogue DLG_AMARA/AMARA_WAITING text.'
  - Key: dialogue.dlg_dev.node.dev_after_sleep.speaker
    Value: 'Dev'
    Note: 'Dialogue DLG_DEV/DEV_AFTER_SLEEP speaker.'
  - Key: dialogue.dlg_dev.node.dev_after_sleep.text
    Value: '...'
    Note: 'Dialogue DLG_DEV/DEV_AFTER_SLEEP text.'
  - Key: dialogue.dlg_dev.node.dev_intro.choice.0
    Value: 'You counted my laps?'
    Note: 'Dialogue choice DLG_DEV/DEV_INTRO #1.'
  - Key: dialogue.dlg_dev.node.dev_intro.choice.1
    Value: 'The Queen sent for me.'
    Note: 'Dialogue choice DLG_DEV/DEV_INTRO #2.'
  - Key: dialogue.dlg_dev.node.dev_intro.low_integrity
    Value: 'You look familiar, but I cannot place where we met. Were you one of the guards?'
    Note: 'Dialogue DLG_DEV/DEV_INTRO low_integrity.'
  - Key: dialogue.dlg_dev.node.dev_intro.speaker
    Value: 'Dev'
    Note: 'Dialogue DLG_DEV/DEV_INTRO speaker.'
  - Key: dialogue.dlg_dev.node.dev_intro.text
    Value: 'There he is. Thirty laps of the training ground before sunrise and he still walks like he is being marked on it.'
    Note: 'Dialogue DLG_DEV/DEV_INTRO text.'
  - Key: dialogue.dlg_dev.node.dev_joke.speaker
    Value: 'Dev'
    Note: 'Dialogue DLG_DEV/DEV_JOKE speaker.'
  - Key: dialogue.dlg_dev.node.dev_joke.text
    Value: 'I count everything. It is the only thing I am better at than you, and I intend to keep it.'
    Note: 'Dialogue DLG_DEV/DEV_JOKE text.'
  - Key: dialogue.dlg_dev.node.dev_quest.speaker
    Value: 'Dev'
    Note: 'Dialogue DLG_DEV/DEV_QUEST speaker.'
  - Key: dialogue.dlg_dev.node.dev_quest.text
    Value: 'The old ruins? Ishan, nobody goes out there. Not because it is forbidden. Because nobody thinks of it. I have lived here my whole life and I have never once thought of it. Does that not strike you as strange?'
    Note: 'Dialogue DLG_DEV/DEV_QUEST text.'
  - Key: dialogue.dlg_dev.node.dev_serious.speaker
    Value: 'Dev'
    Note: 'Dialogue DLG_DEV/DEV_SERIOUS speaker.'
  - Key: dialogue.dlg_dev.node.dev_serious.text
    Value: 'She sends for you a great deal lately. Go on. I will be here - the market does not guard itself, and someone has to be seen failing to guard it.'
    Note: 'Dialogue DLG_DEV/DEV_SERIOUS text.'
  - Key: dialogue.dlg_mira.node.mira_after_memory.speaker
    Value: 'Mira'
    Note: 'Dialogue DLG_MIRA/MIRA_AFTER_MEMORY speaker.'
  - Key: dialogue.dlg_mira.node.mira_after_memory.text
    Value: 'You said it out loud, did you not. Good. Then there are two of us who cannot quite repeat it, and that is one more than there was yesterday.'
    Note: 'Dialogue DLG_MIRA/MIRA_AFTER_MEMORY text.'
  - Key: dialogue.dlg_mira.node.mira_count.speaker
    Value: 'Mira'
    Note: 'Dialogue DLG_MIRA/MIRA_COUNT speaker.'
  - Key: dialogue.dlg_mira.node.mira_count.text
    Value: 'Seven, eight times. Eight, once. I threw that page away, which was the single least scholarly act of my life, and I could not tell you why I did it.'
    Note: 'Dialogue DLG_MIRA/MIRA_COUNT text.'
  - Key: dialogue.dlg_mira.node.mira_intro.speaker
    Value: 'Mira'
    Note: 'Dialogue DLG_MIRA/MIRA_INTRO speaker.'
  - Key: dialogue.dlg_mira.node.mira_intro.text
    Value: 'You are the Queen''s soldier. Do not look startled, it is not insight, you are the only person in Avarsha who stands like that.'
    Note: 'Dialogue DLG_MIRA/MIRA_INTRO text.'
  - Key: dialogue.dlg_mira.node.mira_quest.choice.0
    Value: 'What did you count?'
    Note: 'Dialogue choice DLG_MIRA/MIRA_QUEST #1.'
  - Key: dialogue.dlg_mira.node.mira_quest.choice.1
    Value: 'Then I''ll count it a tenth time.'
    Note: 'Dialogue choice DLG_MIRA/MIRA_QUEST #2.'
  - Key: dialogue.dlg_mira.node.mira_quest.speaker
    Value: 'Mira'
    Note: 'Dialogue DLG_MIRA/MIRA_QUEST speaker.'
  - Key: dialogue.dlg_mira.node.mira_quest.text
    Value: 'The ruin stone. Yes. I have copied that carving nine times and I have nine different counts, and I am not a careless woman.'
    Note: 'Dialogue DLG_MIRA/MIRA_QUEST text.'
  - Key: dialogue.dlg_mira.node.mira_send.speaker
    Value: 'Mira'
    Note: 'Dialogue DLG_MIRA/MIRA_SEND speaker.'
  - Key: dialogue.dlg_mira.node.mira_send.text
    Value: 'Go and look. And Ishan - whatever you read there, say it out loud before you walk away from it. Things last longer when they are spoken.'
    Note: 'Dialogue DLG_MIRA/MIRA_SEND text.'
